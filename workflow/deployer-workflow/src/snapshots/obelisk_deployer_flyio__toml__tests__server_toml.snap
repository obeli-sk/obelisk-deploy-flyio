---
source: workflow/deployer-workflow/src/toml.rs
expression: server_toml
---
[database.sqlite]
directory = "/volume/obelisk-sqlite"

[database.sqlite.pragma]
cache_size = "3000"

[[http_server]]
listening_addr = "[::]:9091"
name = "healthcheck_server"

[log.file]
directory = "/var/log"
enabled = true
prefix = "obelisk.log"
target = true

[[outbound_http.allowed_host]]
methods = "*"
pattern = "*://*:*"
replace_in = ["headers"]
secrets = [
    "GITHUB_TOKEN",
    "OPENAI_API_KEY",
    "TURSO_TOKEN",
]

[public_env]
allowed = ["TURSO_LOCATION"]

[secrets.GITHUB_TOKEN]
env = "GITHUB_TOKEN"

[secrets.GITHUB_WEBHOOK_SECRET]
env = "GITHUB_WEBHOOK_SECRET"

[secrets.GITHUB_WEBHOOK_SECRET.exposed_to]
stargazers_webhook = "sha256:4444444444444444444444444444444444444444444444444444444444444444"

[secrets.OPENAI_API_KEY]
env = "OPENAI_API_KEY"

[secrets.TURSO_TOKEN]
env = "TURSO_TOKEN"

[wasm]
cache_directory = "/volume/wasm"
parallel_compilation = false

[wasm.codegen_cache]
directory = "/volume/codegen"
